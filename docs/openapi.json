    "/v1/devices": {
      "post": {
        "operationId": "DevicesController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Register or update a device (idempotent)",
        "tags": [
          "Devices"
        ]
      }
    },
    "/v1/devices/{deviceId}": {
      "patch": {
        "operationId": "DevicesController_updateToken",
        "parameters": [
          {
            "name": "deviceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Update push token for an existing device",
        "tags": [
          "Devices"
        ]
      }
    }
  },
  "info": {
    "title": "Worldcup Backend API",
    "description": "FIFA World Cup 2026 companion backend — REST v1",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "pushToken": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        },
        "required": [
          "deviceId",
          "platform"
        ]
      },
      "UpdateTokenDto": {
        "type": "object",
        "properties": {
          "pushToken": {
            "type": "string"
          }
        }
      }
    }
  }
}