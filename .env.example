# Copy this file to .env and fill in your values.
# Real .env is gitignored — never commit it.

# PostgreSQL connection string (Docker local: worldcup-pg)
DATABASE_URL=postgres://postgres:dev@localhost:5432/worldcup

# HTTP port for the API server
PORT=3000

# Runtime environment
NODE_ENV=development

# WebSocket fallback port (leave unset to share HTTP port 3000)
# WS_PORT=3001

# ── Live score polling (ESPN → worldcupjson → football-data fallback chain) ──
LIVE_SYNC_ENABLED=false
# Cron — supports 6-field (with seconds), e.g. "*/30 * * * * *" = every 30s
LIVE_SYNC_CRON=*/1 * * * *

# ── football-data.org token (free tier: 10 req/min) ──
# Register at https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_token_here

# ── Pre-match officials job (§8 D) — football-data referees[] ──
OFFICIALS_SYNC_ENABLED=false
OFFICIALS_SYNC_CRON=0 * * * *

# ── Pre-match lineups job (§8 E) — ESPN /summary rosters ──
LINEUPS_SYNC_ENABLED=false
LINEUPS_SYNC_CRON=*/5 * * * *

# ── Push notifications (Expo Push API) ──
PUSH_ENABLED=false

# ── FIFA first-party API (secondary / enrichment — optional) ──
# FIFA enrichment (optional; defaults are set in code). Never a runtime dependency.
# FIFA_API_BASE_URL=
# FIFA_SEASON_ID=
# Enrichment job is off by default
FIFA_SYNC_ENABLED=false
FIFA_SYNC_CRON=*/5 * * * *
