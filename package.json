{
  "name": "worldcup-backend",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.2",
  "description": "Open-source FIFA World Cup 2026 companion backend — REST + WebSocket API with a pre-loaded PostgreSQL dataset (teams, squads, fixtures, venues, standings, broadcasts, content) from multiple public sources. NestJS 11 + Fastify + Drizzle.",
  "author": "Emre BALLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emrbli/worldcup.git"
  },
  "homepage": "https://github.com/emrbli/worldcup#readme",
  "bugs": {
    "url": "https://github.com/emrbli/worldcup/issues"
  },
  "keywords": [
    "worldcup",
    "world-cup-2026",
    "football",
    "soccer",
    "fifa",
    "nestjs",
    "fastify",
    "drizzle",
    "postgresql",
    "rest-api",
    "websocket",
    "typescript",
    "open-data"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx db/seed/index.ts",
    "seed:content": "tsx db/seed/wc26mcp.ts",
    "seed:i18n": "tsx db/seed/i18n.ts",
    "seed:squads": "tsx scripts/seed-squads.ts",
    "enrich:squads:fifa": "tsx scripts/enrich-fifa-squads.ts",
    "sync:live": "tsx scripts/sync-live.ts",
    "sync:officials": "tsx scripts/sync-officials.ts",
    "sync:fifa": "tsx scripts/sync-fifa.ts",
    "calc:standings": "tsx scripts/calc-standings.ts",
    "dataset:build": "bash scripts/build-dataset.sh",
    "dataset:verify": "tsx scripts/verify-dataset.ts",
    "db:restore": "bash scripts/db-restore.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/platform-ws": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.24",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "wc26-mcp": "^0.3.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
